# ==========================================
# Pokémon Telegram Bot Environment Variables (Template)
# Copy this file to .env and fill in your values
# ==========================================

# 1. Telegram Bot Token (Get from @BotFather on Telegram)
TELOXIDE_TOKEN=your_bot_token_here

# 2. Database Configuration
# For Local Run:
DATABASE_URL=sqlite://pokemon_bot.db?mode=rwc
# For Docker / AWS EC2 Deployment:
# DATABASE_URL=sqlite:///app/data/pokemon_bot.db?mode=rwc

# 3. Administrator Settings (Comma-separated Telegram user IDs)
ADMIN_IDS=123456789

# 4. Web Admin Panel Configuration
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5000
ADMIN_PANEL_KEY=ozone_gym_admin_2026

# 5. Game Data & Asset Paths
POKEDEX_PATH=./pokedex.json
ASSETS_DIR=./assets
METADATA_PATH=./assets/unreleased_artworks/metadata.json

# 6. Logging & Diagnostics
RUST_LOG=info,ozone_pokemon_bot=debug,teloxide=info
RUST_BACKTRACE=1

# 7. Optional AWS S3 Database Backups
# S3_BACKUP_BUCKET=my-pokemon-bot-backups
